AICREDITS_API_KEY=sk-your-key-here
AICREDITS_BASE_URL=https://aicredits.in/v1
AICREDITS_FALLBACK_BASE_URL=https://api.aicredits.in/v1
VIDEO_MODEL=openai/gpt-4.1-mini
SPEECH_MODEL=openai/tts-1
SPEECH_VOICE=alloy
SPEECH_FORMAT=mp3
TRANSCRIBE_MODEL=openai/whisper-1
PROMPT_MAX_CHARS=20000
PORT=3000

# Neatlogs tracing (ingest key, read by manim-service via docker compose)
NEATLOGS_API_KEY=nl-your-key-here

# Authentication (Better Auth & Resend Email)
BETTER_AUTH_SECRET=your-random-secret-key-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Shawtty <no-reply@yourdomain.com>
